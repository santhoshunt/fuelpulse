<?xml version="1.0" encoding="utf-8"?>
<!-- Track and fill for widget progress bars (tank level, service due). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#33FFFFFF" /><corners android:radius="3dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="#7FA6E6" /><corners android:radius="3dp" /></shape></clip>
    </item>
</layer-list>
