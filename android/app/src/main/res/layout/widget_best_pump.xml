<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@drawable/widget_bg">
        <TextView android:includeFontPadding="false" android:id="@+id/cap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#AFC0D8" android:letterSpacing="0.08" android:maxLines="1" android:ellipsize="end" />
        <TextView android:includeFontPadding="false" android:id="@+id/value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:textColor="#F5F7FA" android:maxLines="1" android:ellipsize="end" />
        <TextView android:includeFontPadding="false" android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#AFC0D8" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
