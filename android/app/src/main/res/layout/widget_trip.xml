<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/cap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#AFC0D8" android:letterSpacing="0.08" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" android:textColor="#F5F7FA" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#AFC0D8" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/action" android:layout_width="wrap_content" android:layout_height="36dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:gravity="center" android:text="Start" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/widget_button" />
</LinearLayout>
